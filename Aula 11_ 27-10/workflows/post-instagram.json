      "parameters": {
        "jsCode": "// O formulário entrega o arquivo com o rótulo do campo como chave do binário.\n// Aqui ele passa a se chamar \"imagem\", e a legenda vai para o JSON.\nconst item = $input.first();\nconst chave = Object.keys(item.binary ?? {})[0];\nif (!chave) throw new Error('Nenhum arquivo recebido do formulário.');\nconst arquivo = item.binary[chave];\nif (arquivo.mimeType !== 'image/jpeg') throw new Error(`O Instagram aceita só JPEG; o arquivo é ${arquivo.mimeType}.`);\nconst legenda = item.json.legenda ?? item.json.Legenda ?? '';\nreturn [{ json: { arquivo: arquivo.fileName, legenda }, binary: { imagem: arquivo } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
