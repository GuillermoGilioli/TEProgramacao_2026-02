    {
      "parameters": {
        "jsCode": "// A Meta envia um POST com object, entry[] e, dentro de cada entry,\n// changes[] (comentários) ou messaging[] (mensagens do Direct).\n// Este nó devolve um item por evento, com o campo \"tipo\" para o Switch.\nconst saida = [];\nfor (const item of $input.all()) {\n  const corpo = item.json.body ?? {};\n  for (const entrada of corpo.entry ?? []) {\n    for (const mudanca of entrada.changes ?? []) {\n      if (mudanca.field !== 'comments') continue;\n      const v = mudanca.value ?? {};\n      saida.push({ json: {\n        tipo: 'comentario',\n        comentario_id: v.id,\n        texto: v.text ?? '',\n        de_id: v.from?.id,\n        de_usuario: v.from?.username,\n        midia_id: v.media?.id,\n        midia_tipo: v.media?.media_product_type,\n        pai_id: v.parent_id ?? null,\n      }});\n    }\n    for (const m of entrada.messaging ?? []) {\n      if (!m.message || !m.message.text || m.message.is_echo) continue;\n      saida.push({ json: {\n        tipo: 'mensagem',\n        remetente: m.sender?.id,\n        destinatario: m.recipient?.id,\n        texto: m.message.text,\n        mensagem_id: m.message.mid,\n      }});\n    }\n  }\n}\nreturn saida;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
