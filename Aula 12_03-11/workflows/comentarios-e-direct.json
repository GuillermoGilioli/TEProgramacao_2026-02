    {
      "parameters": {
        "jsCode": "// Tabela de palavras-chave do post. A primeira regra que casar define a resposta.\n// Toda resposta termina identificando que foi automática.\nconst regras = [\n  { palavras: ['senha', 'wifi', 'wi-fi', 'roteador', 'internet'],\n    resposta: 'A senha do Wi-Fi do Professor Parafuso é segredo de Estado, mas o roteador agradece se você reiniciar ele de vez em quando.' },\n  { palavras: ['video', 'vídeo', 'edicao', 'edição', 'como fez', 'como faz'],\n    resposta: 'Os vídeos do perfil são feitos com automação, usando n8n e modelos de IA.' },\n  { palavras: ['parafuso', 'professor'],\n    resposta: 'O Professor Parafuso agradece a audiência e já está inventando a próxima.' },\n  { palavras: ['parabéns', 'parabens', 'obrigado', 'obrigada', 'valeu', 'top', 'show'],\n    resposta: 'Obrigado pela força!' },\n];\nconst normalizar = (t) => t.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst saida = [];\nfor (const item of $input.all()) {\n  const texto = normalizar(item.json.texto ?? '');\n  const regra = regras.find(r => r.palavras.some(p => texto.includes(normalizar(p))));\n  if (!regra) continue; // sem palavra-chave: não responde\n  saida.push({ json: { ...item.json, palavra: regra.palavras[0],\n    resposta: `${regra.resposta} (resposta automática)` } });\n}\nreturn saida;"
      },
